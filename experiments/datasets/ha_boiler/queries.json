{
  "project": "HA_Boiler",
  "description": "Query dataset for HA_Boiler — ESP32-based home automation with Modbus, MQTT, DS18B20 sensors, boiler control",
  "queries": [
    {
      "query": "boiler temperature regulation",
      "split": "sig",
      "relevant": [["boiler_control", "src/control.cpp"], ["control_setup", "src/control.cpp"]]
    },
    {
      "query": "modbus polling communication",
      "split": "sig",
      "relevant": [["modbus_poll", "src/modbus.cpp"], ["modbus_setup", "src/modbus.cpp"]]
    },
    {
      "query": "home assistant mqtt update",
      "split": "sig",
      "relevant": [["ha_update", "src/ha_mqtt.cpp"], ["ha_setup", "src/ha_mqtt.cpp"], ["onTempReq1", "src/ha_mqtt.cpp"]]
    },
    {
      "query": "temperature sensor reading",
      "split": "sig",
      "relevant": [["getTemp", "src/sensors.cpp"], ["sensors_setup", "src/sensors.cpp"]]
    },
    {
      "query": "modbus response handler",
      "split": "sig",
      "relevant": [["handleData", "src/modbus.cpp"], ["handleError", "src/modbus.cpp"]]
    },
    {
      "query": "config mode baudrate flags",
      "split": "sig",
      "relevant": [["setTargetTemperature", "src/ha_mqtt.cpp"]]
    },
    {
      "query": "decround decimal round",
      "split": "sig",
      "relevant": [["decround", "src/utils.h"]]
    },
    {
      "query": "time available NTP sync",
      "split": "sig",
      "relevant": [["timeavailable", "src/main.cpp"], ["printLocalTime", "src/main.cpp"], ["updateMyTimeVars", "src/utils.h"]]
    },
    {
      "query": "modbus stale connection check",
      "split": "sig",
      "relevant": [["modbus_is_stale", "src/modbus.cpp"]]
    },
    {
      "query": "mqtt publish home assistant",
      "split": "sig",
      "relevant": [["ha_update", "src/ha_mqtt.cpp"]]
    },
    {
      "query": "verify response length packet",
      "split": "impl",
      "relevant": [["handleData", "src/modbus.cpp"]]
    },
    {
      "query": "millis last poll timestamp",
      "split": "impl",
      "relevant": [["modbus_poll", "src/modbus.cpp"], ["modbus_is_stale", "src/modbus.cpp"]]
    },
    {
      "query": "client publish topic retain",
      "split": "impl",
      "relevant": [["ha_update", "src/ha_mqtt.cpp"]]
    },
    {
      "query": "OneWire Dallas sensor address",
      "split": "impl",
      "relevant": [["getTemp", "src/sensors.cpp"], ["sensors_setup", "src/sensors.cpp"]]
    },
    {
      "query": "WiFi reconnect status loop",
      "split": "impl",
      "relevant": [["loop", "src/main.cpp"], ["setup", "src/main.cpp"]]
    },
    {
      "query": "ModbusMessage token response",
      "split": "impl",
      "relevant": [["handleData", "src/modbus.cpp"], ["handleError", "src/modbus.cpp"]]
    },
    {
      "query": "timeval tv_sec set",
      "split": "impl",
      "relevant": [["timeavailable", "src/main.cpp"]]
    },
    {
      "query": "round pow places",
      "split": "impl",
      "relevant": [["decround", "src/utils.h"]]
    }
  ]
}
